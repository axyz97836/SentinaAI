# Local development only. Generate unique values with: node infra/scripts/setup-env.mjs
# Empty secrets deliberately prevent Compose startup until configured.
COMPOSE_PROJECT_NAME=sentinelai
FRONTEND_PORT=3000
API_PORT=8000
POSTGRES_DB=sentinelai
POSTGRES_USER=sentinel_owner
POSTGRES_PASSWORD=
APP_DB_USER=sentinel_app
APP_DB_PASSWORD=
REDIS_PASSWORD=
S3_BUCKET=sentinel-local
S3_ACCESS_KEY=
S3_SECRET_KEY=
# API signing key lives separately in ignored .local/auth.env (make auth-env).
# Local HTTP only; use explicit HTTPS origins and Secure cookies for production.
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
